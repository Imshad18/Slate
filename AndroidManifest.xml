<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.slate.app"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <!-- Reading a file the user explicitly handed us needs no permission at
         all: the URI arrives with a grant attached. These two are only for
         the legacy case of a plain file:// path from an older app. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="Slate"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:largeHeap="true"
        android:theme="@style/SlateTheme">

        <activity
            android:name=".Slate"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|locale"
            android:windowSoftInputMode="adjustResize">

            <!-- launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- by MIME type. This is the route that matters: a provider
                 almost always knows the type even when the path has no
                 extension at all. -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/x-javascript" />
                <data android:mimeType="application/ecmascript" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/x-shellscript" />
                <data android:mimeType="application/x-python" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/toml" />
                <data android:mimeType="application/sql" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/java-archive" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- by extension, for providers that report no useful type -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\..*\\.txt" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\..*\\.md" />
                <data android:pathPattern=".*\\.markdown" />
                <data android:pathPattern=".*\\..*\\.markdown" />
                <data android:pathPattern=".*\\.log" />
                <data android:pathPattern=".*\\..*\\.log" />
                <data android:pathPattern=".*\\.csv" />
                <data android:pathPattern=".*\\..*\\.csv" />
                <data android:pathPattern=".*\\.tsv" />
                <data android:pathPattern=".*\\..*\\.tsv" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\..*\\.json" />
                <data android:pathPattern=".*\\.xml" />
                <data android:pathPattern=".*\\..*\\.xml" />
                <data android:pathPattern=".*\\.yaml" />
                <data android:pathPattern=".*\\..*\\.yaml" />
                <data android:pathPattern=".*\\.yml" />
                <data android:pathPattern=".*\\..*\\.yml" />
                <data android:pathPattern=".*\\.toml" />
                <data android:pathPattern=".*\\..*\\.toml" />
                <data android:pathPattern=".*\\.ini" />
                <data android:pathPattern=".*\\..*\\.ini" />
                <data android:pathPattern=".*\\.cfg" />
                <data android:pathPattern=".*\\..*\\.cfg" />
                <data android:pathPattern=".*\\.conf" />
                <data android:pathPattern=".*\\..*\\.conf" />
                <data android:pathPattern=".*\\.py" />
                <data android:pathPattern=".*\\..*\\.py" />
                <data android:pathPattern=".*\\.java" />
                <data android:pathPattern=".*\\..*\\.java" />
                <data android:pathPattern=".*\\.c" />
                <data android:pathPattern=".*\\..*\\.c" />
                <data android:pathPattern=".*\\.cpp" />
                <data android:pathPattern=".*\\..*\\.cpp" />
                <data android:pathPattern=".*\\.h" />
                <data android:pathPattern=".*\\..*\\.h" />
                <data android:pathPattern=".*\\.hpp" />
                <data android:pathPattern=".*\\..*\\.hpp" />
                <data android:pathPattern=".*\\.cs" />
                <data android:pathPattern=".*\\..*\\.cs" />
                <data android:pathPattern=".*\\.js" />
                <data android:pathPattern=".*\\..*\\.js" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\..*\\.ts" />
                <data android:pathPattern=".*\\.jsx" />
                <data android:pathPattern=".*\\..*\\.jsx" />
                <data android:pathPattern=".*\\.tsx" />
                <data android:pathPattern=".*\\..*\\.tsx" />
                <data android:pathPattern=".*\\.go" />
                <data android:pathPattern=".*\\..*\\.go" />
                <data android:pathPattern=".*\\.rs" />
                <data android:pathPattern=".*\\..*\\.rs" />
                <data android:pathPattern=".*\\.rb" />
                <data android:pathPattern=".*\\..*\\.rb" />
                <data android:pathPattern=".*\\.php" />
                <data android:pathPattern=".*\\..*\\.php" />
                <data android:pathPattern=".*\\.sh" />
                <data android:pathPattern=".*\\..*\\.sh" />
                <data android:pathPattern=".*\\.bash" />
                <data android:pathPattern=".*\\..*\\.bash" />
                <data android:pathPattern=".*\\.sql" />
                <data android:pathPattern=".*\\..*\\.sql" />
                <data android:pathPattern=".*\\.css" />
                <data android:pathPattern=".*\\..*\\.css" />
                <data android:pathPattern=".*\\.scss" />
                <data android:pathPattern=".*\\..*\\.scss" />
                <data android:pathPattern=".*\\.html" />
                <data android:pathPattern=".*\\..*\\.html" />
                <data android:pathPattern=".*\\.htm" />
                <data android:pathPattern=".*\\..*\\.htm" />
                <data android:pathPattern=".*\\.kt" />
                <data android:pathPattern=".*\\..*\\.kt" />
                <data android:pathPattern=".*\\.swift" />
                <data android:pathPattern=".*\\..*\\.swift" />
                <data android:pathPattern=".*\\.dart" />
                <data android:pathPattern=".*\\..*\\.dart" />
                <data android:pathPattern=".*\\.lua" />
                <data android:pathPattern=".*\\..*\\.lua" />
                <data android:pathPattern=".*\\.pl" />
                <data android:pathPattern=".*\\..*\\.pl" />
                <data android:pathPattern=".*\\.r" />
                <data android:pathPattern=".*\\..*\\.r" />
                <data android:pathPattern=".*\\.m" />
                <data android:pathPattern=".*\\..*\\.m" />
                <data android:pathPattern=".*\\.diff" />
                <data android:pathPattern=".*\\..*\\.diff" />
                <data android:pathPattern=".*\\.patch" />
                <data android:pathPattern=".*\\..*\\.patch" />
                <data android:pathPattern=".*\\.properties" />
                <data android:pathPattern=".*\\..*\\.properties" />
                <data android:pathPattern=".*\\.env" />
                <data android:pathPattern=".*\\..*\\.env" />
                <data android:pathPattern=".*\\.gradle" />
                <data android:pathPattern=".*\\..*\\.gradle" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\..*\\.pdf" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathPattern=".*\\..*\\.docx" />
                <data android:pathPattern=".*\\.xlsx" />
                <data android:pathPattern=".*\\..*\\.xlsx" />
                <data android:pathPattern=".*\\.pptx" />
                <data android:pathPattern=".*\\..*\\.pptx" />
                <data android:pathPattern=".*\\.odt" />
                <data android:pathPattern=".*\\..*\\.odt" />
                <data android:pathPattern=".*\\.ods" />
                <data android:pathPattern=".*\\..*\\.ods" />
                <data android:pathPattern=".*\\.odp" />
                <data android:pathPattern=".*\\..*\\.odp" />
                <data android:pathPattern=".*\\.rtf" />
                <data android:pathPattern=".*\\..*\\.rtf" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\..*\\.epub" />
                <data android:pathPattern=".*\\.doc" />
                <data android:pathPattern=".*\\..*\\.doc" />
                <data android:pathPattern=".*\\.xls" />
                <data android:pathPattern=".*\\..*\\.xls" />
                <data android:pathPattern=".*\\.ppt" />
                <data android:pathPattern=".*\\..*\\.ppt" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\..*\\.zip" />
                <data android:pathPattern=".*\\.jar" />
                <data android:pathPattern=".*\\..*\\.jar" />
                <data android:pathPattern=".*\\.apk" />
                <data android:pathPattern=".*\\..*\\.apk" />
                <data android:pathPattern=".*\\.tar" />
                <data android:pathPattern=".*\\..*\\.tar" />
                <data android:pathPattern=".*\\.gz" />
                <data android:pathPattern=".*\\..*\\.gz" />
            </intent-filter>

            <!-- shared in from another app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
