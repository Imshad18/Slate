# Build output — everything here is regenerated by ./build.sh
out/
gen/

# Signing material. The build makes a throwaway debug keystore in the
# toolchain directory, outside the repo; nothing signed here is distributable.
*.keystore
*.jks
*.p12

# The signed APK at the repo root IS shipped — it is the whole point of a
# release. Only the build's intermediate copies under out/ are ignored.
!/*.apk
